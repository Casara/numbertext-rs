; This file is for unifying the coding style for different editors and IDEs.
; More information at http://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true
# A JetBrains-specific extension, not part of the EditorConfig spec -
# editors that don't know it ignore it. It is here so RustRover/IntelliJ
# draws the same guides .vscode/settings.json already asks VS Code for
# (`editor.rulers`), instead of the visible margin depending on which
# editor opened the file. 100 is rustfmt's max_width; 80 and 120 bracket
# it for prose and for the wider Markdown limit below.
ij_visual_guides = 80,100,120

# JSON / YAML / TOML
[*.{json,yaml,yml,toml}]
indent_size = 2

# Markdown
[*.md]
# Because:
# - most formatters (like Prettier) use 2 spaces
# - lists can become inconsistent depending on the editor
indent_size = 2
max_line_length = 120
# double whitespace at end of line
# denotes a line break in Markdown
trim_trailing_whitespace = false

# Shell, including the completion scripts, which are shell but do not
# carry a .sh suffix (zsh autoloads its one by the bare name
# `_numbertext`, and that is not negotiable).
[{*.sh,*.bash,*.fish,_numbertext}]
indent_size = 4

# Rust: rustfmt's defaults, which this project does not override
# (see rustfmt.toml).
[*.rs]
indent_style = space
indent_size = 4

# Makefiles always use tabs for indentation
[{Makefile,.gitmodules}]
indent_style = tab
indent_size = 4

# Upstream data, synced verbatim (see data/SOURCE.md) - never reformatted.
[data/*.sor]
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
max_line_length = unset
