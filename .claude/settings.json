{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make build*)",
      "Bash(make run*)",
      "Bash(make fmt*)",
      "Bash(make lint*)",
      "Bash(make audit*)",
      "Bash(make doc*)",
      "Bash(make test*)",
      "Bash(make coverage*)",
      "Bash(make gen-features*)",
      "Bash(make sync-data*)",
      "Bash(make check*)",
      "Bash(make msrv*)",
      "Bash(make clean*)",
      "Bash(make watch*)",
      "Bash(make semver-checks*)",
      "Bash(make check-data*)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo run *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny *)",
      "Bash(cargo mutants *)",
      "Bash(cargo add *)",
      "Bash(cargo update *)",
      "Bash(cargo --version)",
      "Bash(cargo nextest *)",
      "Bash(cargo hack *)",
      "Bash(cargo semver-checks *)",
      "Bash(cargo llvm-cov *)",
      "Bash(cargo watch *)",
      "Bash(cargo install --locked *)",
      "Bash(rustfmt --print-config*)",
      "Bash(rustup toolchain install*)",
      "Bash(rustc --version)",
      "Bash(rustup show*)",
      "Bash(rustup toolchain list*)",
      "Bash(npx --yes markdownlint-cli2@0.23.2 *)",
      "Bash(python3 scripts/gen-locale-features.py*)",
      "Bash(python3 scripts/check-data-provenance.py*)",
      "Bash(bash scripts/sync-data.sh*)",
      "Bash(bash scripts/doc-sync-check.sh*)",
      "Bash(set -e)",
      "Bash(disown)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git grep*)",
      "Bash(git blame*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git tag)",
      "Bash(git tag --list*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git shortlog*)",
      "Bash(git hash-object*)",
      "Bash(git stash list)",
      "Bash(git remote -v)",
      "Bash(git ls-remote*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "WebSearch",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:rust-lang.github.io)",
      "WebFetch(domain:mutants.rs)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:numbertext.github.io)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/doc-sync-check.sh 2>/dev/null | python3 -c \"import sys,json; t=sys.stdin.read().strip(); print(json.dumps({'systemMessage': t}) if t else '', end='')\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
